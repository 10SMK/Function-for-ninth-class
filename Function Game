          </div>

          <div class="landmark school">
            <div class="landmark-icon">🏫</div>
            <span>SEKOLAH</span>
          </div>

          <div class="landmark shop">
            <div class="landmark-icon">🏪</div>
            <span>MINIMARKET</span>
          </div>

