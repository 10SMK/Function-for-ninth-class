<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Courier Quest: Misi Fungsi</title>
  <style>
    :root {
      --ink: #202b3a;
      --muted: #667085;
      --paper: #ffffff;
      --sky: #cceefa;
      --yellow: #ffd766;
      --orange: #f28c52;
      --red: #e76868;
      --green: #4caa78;
      --shadow: 0 6px 0 rgba(32, 43, 58, .16);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      font-family: "Trebuchet MS", "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at 7% 10%, rgba(255, 255, 255, .85) 0 42px, transparent 43px),
        radial-gradient(circle at 93% 17%, rgba(255, 255, 255, .65) 0 52px, transparent 53px),
        linear-gradient(145deg, #bcebf5 0%, #fff2cf 54%, #c7ebcb 100%);
    }

    button {
      font: inherit;
      cursor: pointer;
    }

    .app {
      width: min(1440px, 100%);
      min-height: 100vh;
      margin: auto;
      padding: 14px;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 12px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-mark {
      display: grid;
      place-items: center;
      width: 56px;
      height: 56px;
      border: 3px solid var(--ink);
      border-radius: 16px;
      background: var(--yellow);
      box-shadow: var(--shadow);
      font-size: 29px;
    }

    .eyebrow {
      margin: 0 0 3px;
      color: #805e1e;
      font-size: .7rem;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    h1,
    h2,
    p {
      margin-top: 0;
    }

    h1 {
      margin-bottom: 0;
      font-size: clamp(1.25rem, 2.4vw, 2rem);
      line-height: 1;
    }

    .top-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
    }

    .badge {
      min-height: 41px;
      padding: 9px 13px;
      border: 3px solid var(--ink);
      border-radius: 12px;
      background: var(--paper);
      box-shadow: 3px 3px 0 rgba(32, 43, 58, .14);
      font-size: .84rem;
      font-weight: 900;
    }

    .badge strong {
      color: #9b6512;
    }

    .hearts {
      letter-spacing: 2px;
    }

    .heart-off {
      opacity: .24;
      filter: grayscale(1);
    }

    .game-grid {
      display: grid;
      grid-template-columns: 275px minmax(550px, 1fr) 250px;
      gap: 12px;
      align-items: stretch;
    }

    .card {
      border: 3px solid var(--ink);
      border-radius: 18px;
      background: rgba(255, 255, 255, .95);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .card-heading {
      margin: 0;
      padding: 12px 14px;
      border-bottom: 3px solid var(--ink);
      background: var(--sky);
      font-size: .95rem;
      line-height: 1.1;
    }

    .card-heading small {
      display: block;
      margin-top: 4px;
      color: var(--muted);
      font-size: .7rem;
    }

    .mission-card {
      min-height: 640px;
    }

    .mission-body {
      padding: 14px;
    }

    .mission-intro {
      margin-bottom: 12px;
      padding: 11px;
      border-radius: 12px;
      background: #fff4bf;
      font-size: .83rem;
      font-weight: 800;
      line-height: 1.4;
    }

    .objective {
      padding: 12px;
      border: 2px dashed #c28c22;
      border-radius: 14px;
      background: #fffdf3;
    }

    .objective-label {
      color: var(--muted);
      font-size: .68rem;
      font-weight: 900;
      letter-spacing: .07em;
      text-transform: uppercase;
    }

    .objective-value {
      margin: 5px 0;
      color: #af7113;
      font-size: 2rem;
      font-weight: 900;
    }

    .objective-status {
      min-height: 34px;
      color: var(--muted);
      font-size: .78rem;
      font-weight: 900;
      line-height: 1.35;
    }

    .route-box {
      position: relative;
      margin-top: 14px;
      padding: 14px 10px;
      border-radius: 12px;
      background: #f0f6f2;
    }

    .route-step {
      position: relative;
      display: flex;
      align-items: center;
      gap: 9px;
      min-height: 58px;
      font-size: .79rem;
      font-weight: 900;
    }

    .route-step:not(:last-child)::after {
      content: "";
      position: absolute;
      left: 16px;
      top: 36px;
      width: 3px;
      height: 29px;
      border-left: 3px dashed #82a69b;
    }

    .route-icon {
      position: relative;
      z-index: 1;
      display: grid;
      place-items: center;
      flex: 0 0 35px;
      width: 35px;
      height: 35px;
      border: 2px solid var(--ink);
      border-radius: 50%;
      background: var(--paper);
      font-size: 1.1rem;
    }

    .route-step.active .route-icon {
      background: var(--yellow);
    }

    .route-step.done .route-icon {
      background: #bcebb8;
    }

    .route-step span {
      line-height: 1.25;
    }

    .tips {
      margin-top: 14px;
      padding: 11px;
      border-radius: 12px;
      background: #e8f5ff;
      color: #42627e;
      font-size: .75rem;
      font-weight: 700;
      line-height: 1.45;
    }

    .map-card {
      position: relative;
      min-height: 640px;
      padding: 10px;
      border: 3px solid var(--ink);
      border-radius: 18px;
      background: #8ec794;
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .map {
      position: relative;
      height: 100%;
      min-height: 620px;
      border: 3px solid rgba(32, 43, 58, .47);
      border-radius: 13px;
      overflow: hidden;
      background:
        radial-gradient(ellipse at 19% 72%, rgba(255,255,255,.44) 0 7%, transparent 7.4%),
        radial-gradient(ellipse at 78% 56%, rgba(255,255,255,.38) 0 8%, transparent 8.4%),
        linear-gradient(30deg, transparent 0 43%, #d2d8d0 43% 46%, #859da2 46% 54%, #d2d8d0 54% 57%, transparent 57%),
        linear-gradient(-32deg, transparent 0 38%, #d2d8d0 38% 42%, #849da1 42% 50%, #d2d8d0 50% 54%, transparent 54%),
        linear-gradient(145deg, #d8ebc7, #9fd2a7);
    }

    .map.level-suburb {
      background:
        radial-gradient(ellipse at 18% 72%, rgba(255,255,255,.45) 0 7%, transparent 7.4%),
        radial-gradient(ellipse at 78% 56%, rgba(255,255,255,.4) 0 8%, transparent 8.4%),
        linear-gradient(30deg, transparent 0 43%, #d2d8d0 43% 46%, #859da2 46% 54%, #d2d8d0 54% 57%, transparent 57%),
        linear-gradient(-32deg, transparent 0 38%, #d2d8d0 38% 42%, #849da1 42% 50%, #d2d8d0 50% 54%, transparent 54%),
        linear-gradient(145deg, #d8ebc7, #9fd2a7);
    }

    .map.level-night {
      background:
        radial-gradient(circle at 74% 15%, rgba(255, 235, 151, .9) 0 3%, transparent 3.3%),
        radial-gradient(circle at 16% 20%, rgba(255,255,255,.85) 0 1.2%, transparent 1.5%),
        radial-gradient(circle at 86% 34%, rgba(255,255,255,.8) 0 1%, transparent 1.3%),
        linear-gradient(30deg, transparent 0 43%, #526476 43% 46%, #283b50 46% 54%, #526476 54% 57%, transparent 57%),
        linear-gradient(-32deg, transparent 0 38%, #526476 38% 42%, #283b50 42% 50%, #526476 50% 54%, transparent 54%),
        linear-gradient(145deg, #1b3455, #554777);
    }

    .map.level-coast {
      background:
        radial-gradient(ellipse at 83% 23%, #66cddd 0 14%, transparent 14.4%),
        linear-gradient(30deg, transparent 0 43%, #ead9b0 43% 46%, #c6a879 46% 54%, #ead9b0 54% 57%, transparent 57%),
        linear-gradient(-32deg, transparent 0 38%, #ead9b0 38% 42%, #c6a879 42% 50%, #ead9b0 50% 54%, transparent 54%),
        linear-gradient(145deg, #f7dda9, #79cfca);
    }

    .map.level-industrial {
      background:
        radial-gradient(ellipse at 19% 78%, rgba(244, 160, 74, .45) 0 8%, transparent 8.4%),
        linear-gradient(30deg, transparent 0 43%, #c4bdb5 43% 46%, #62666f 46% 54%, #c4bdb5 54% 57%, transparent 57%),
        linear-gradient(-32deg, transparent 0 38%, #c4bdb5 38% 42%, #62666f 42% 50%, #c4bdb5 50% 54%, transparent 54%),
        linear-gradient(145deg, #b9c4c0, #d8895f);
    }

    .map.level-festival {
      background:
        radial-gradient(circle at 77% 14%, rgba(255, 220, 93, .88) 0 2%, transparent 2.4%),
        radial-gradient(circle at 16% 22%, rgba(255, 117, 170, .8) 0 1.4%, transparent 1.8%),
        linear-gradient(30deg, transparent 0 43%, #b7a3c8 43% 46%, #574b71 46% 54%, #b7a3c8 54% 57%, transparent 57%),
        linear-gradient(-32deg, transparent 0 38%, #b7a3c8 38% 42%, #574b71 42% 50%, #b7a3c8 50% 54%, transparent 54%),
        linear-gradient(145deg, #536f9e, #bb6c91);
    }

    .map::before {
      content: attr(data-title);
      position: absolute;
      z-index: 1;
      left: 14px;
      top: 13px;
      padding: 7px 9px;
      border: 2px solid var(--ink);
      border-radius: 8px;
      background: rgba(255, 255, 255, .82);
      font-size: .63rem;
      font-weight: 900;
      letter-spacing: .04em;
    }

    .map::after {
      content: "";
      position: absolute;
      z-index: 0;
      right: 13%;
      bottom: 9%;
      width: 105px;
      height: 50px;
      border: 3px solid rgba(32, 43, 58, .22);
      border-radius: 50%;
      background: rgba(113, 185, 126, .38);
      box-shadow: inset 0 0 0 8px rgba(255,255,255,.18);
      transform: rotate(-8deg);
    }

    .map.level-night::after {
      background: rgba(99, 215, 191, .18);
      border-color: rgba(139, 255, 236, .35);
      box-shadow: inset 0 0 0 8px rgba(139,255,236,.12);
    }

    .map.level-coast::after {
      background: rgba(255, 255, 255, .38);
      border-color: rgba(56, 128, 143, .4);
    }

    .map.level-industrial::after {
      background: rgba(242, 140, 82, .35);
      border-color: rgba(101, 72, 58, .35);
    }

    .map.level-festival::after {
      background: rgba(255, 111, 187, .28);
      border-color: rgba(255, 220, 93, .45);
    }

    .map-help {
      position: absolute;
      z-index: 2;
      right: 13px;
      top: 13px;
      padding: 7px 9px;
      border: 2px solid var(--ink);
      border-radius: 8px;
      background: rgba(255, 249, 208, .93);
      font-size: .68rem;
      font-weight: 900;
    }

    .cloud {
      position: absolute;
      z-index: 1;
      color: rgba(255, 255, 255, .78);
      font-size: 1.75rem;
      filter: drop-shadow(2px 3px 0 rgba(32, 43, 58, .1));
      pointer-events: none;
      animation: drift 7s ease-in-out infinite alternate;
    }

    .cloud.c1 {
      left: 25%;
      top: 7%;
    }

    .cloud.c2 {
      right: 25%;
      top: 34%;
      font-size: 1.25rem;
      animation-delay: -3s;
    }

    .map-sticker {
      position: absolute;
      z-index: 3;
      left: 12%;
      bottom: 8%;
      padding: 6px 8px;
      border: 2px solid var(--ink);
      border-radius: 7px;
      background: #fff0a6;
      color: #7e5b17;
      font-size: .57rem;
      font-weight: 900;
      letter-spacing: .05em;
      transform: rotate(-5deg);
      box-shadow: 2px 3px 0 rgba(32, 43, 58, .14);
      pointer-events: none;
    }

    .level-night .map-sticker {
      background: #b7f5e6;
      color: #315f68;
    }

    .level-coast .map-sticker {
      background: #fff0c3;
      color: #8b6420;
    }

    .level-industrial .map-sticker {
      background: #ffc08c;
      color: #814422;
    }

    .level-festival .map-sticker {
      background: #ffc1dc;
      color: #76385c;
    }

    .landmark {
      position: absolute;
      z-index: 3;
      display: grid;
      place-items: center;
      width: 68px;
      min-height: 55px;
      padding: 4px;
      border: 2px solid rgba(32, 43, 58, .7);
      border-radius: 10px;
      background: rgba(255, 255, 255, .77);
      box-shadow: 3px 3px 0 rgba(32, 43, 58, .12);
      font-size: 1.55rem;
      line-height: 1;
      pointer-events: none;
    }

    .landmark span {
      margin-top: 3px;
      color: var(--muted);
      font-size: .48rem;
      font-weight: 900;
      letter-spacing: .03em;
    }

    .landmark.school {
      left: 38%;
      top: 27%;
      background: #fbe2bd;
    }

    .landmark.shop {
      right: 7%;
      top: 47%;
      background: #d9eff4;
    }

    .landmark.park {
      left: 7%;
      bottom: 30%;
      background: #d6efcb;
    }

    .landmark.cafe {
      right: 38%;
      bottom: 8%;
      background: #eed7f2;
    }

    .level-night .landmark {
      border-color: #b5efe8;
      background: rgba(38, 54, 84, .9);
      color: #f5fff9;
      box-shadow: 0 0 12px rgba(114, 244, 225, .35);
    }

    .level-night .landmark span {
      color: #b5efe8;
    }

    .level-night .landmark.school {
      left: 31%;
      top: 27%;
    }

    .level-night .landmark.shop {
      right: 10%;
      top: 50%;
    }

    .level-night .landmark.park {
      left: 8%;
      bottom: 27%;
    }

    .level-night .landmark.cafe {
      right: 35%;
      bottom: 10%;
    }

    .level-coast .landmark {
      border-color: #477e86;
      background: rgba(255, 251, 225, .9);
    }

    .level-coast .landmark.school {
      left: 35%;
      top: 25%;
    }

    .level-coast .landmark.shop {
      right: 7%;
      top: 46%;
    }

    .level-coast .landmark.park {
      left: 7%;
      bottom: 26%;
    }

    .level-coast .landmark.cafe {
      right: 36%;
      bottom: 8%;
    }

    .level-industrial .landmark {
      border-radius: 5px;
      background: rgba(247, 220, 188, .92);
      box-shadow: 3px 3px 0 rgba(98, 63, 44, .2);
    }

    .level-industrial .landmark.school {
      left: 29%;
      top: 29%;
    }

    .level-industrial .landmark.shop {
      right: 7%;
      top: 48%;
    }

    .level-industrial .landmark.park {
      left: 8%;
      bottom: 25%;
    }

    .level-industrial .landmark.cafe {
      right: 35%;
      bottom: 9%;
    }

    .level-festival .landmark {
      border-color: #ffd95f;
      background: rgba(61, 52, 98, .9);
      color: #fff7ca;
      box-shadow: 0 0 13px rgba(255, 213, 87, .38);
    }

    .level-festival .landmark span {
      color: #ffd95f;
    }

    .level-festival .landmark.school {
      left: 37%;
      top: 27%;
    }

    .level-festival .landmark.shop {
      right: 8%;
      top: 45%;
    }

    .level-festival .landmark.park {
      left: 7%;
      bottom: 27%;
    }

    .level-festival .landmark.cafe {
      right: 35%;
      bottom: 8%;
    }

    .level-night .cloud {
      color: rgba(185, 255, 242, .72);
    }

    .level-coast .cloud {
      color: rgba(255, 255, 255, .9);
    }

    .level-industrial .cloud {
      color: rgba(255, 225, 190, .65);
    }

    .level-festival .cloud {
      color: rgba(255, 213, 239, .82);
    }

    .level-night .station {
      background: #b7f5e6;
      box-shadow: 0 0 16px rgba(114, 244, 225, .6);
    }

    .level-coast .station {
      background: #ffe3a8;
    }

    .level-industrial .station {
      background: #ffb879;
    }

    .level-festival .station {
      background: #ffc0dc;
      box-shadow: 0 0 15px rgba(255, 213, 87, .55);
    }

    .street-label {
      position: absolute;
      z-index: 2;
      padding: 3px 6px;
      border-radius: 5px;
      background: rgba(255,255,255,.58);
      color: #607174;
      font-size: .5rem;
      font-weight: 900;
      letter-spacing: .04em;
      transform: rotate(29deg);
      pointer-events: none;
    }

    .street-label.s1 {
      left: 28%;
      top: 52%;
    }

    .street-label.s2 {
      right: 25%;
      top: 56%;
      transform: rotate(-32deg);
    }

    .level-night .street-label,
    .level-festival .street-label {
      background: rgba(33, 42, 73, .72);
      color: #d0fff4;
    }

    .level-industrial .street-label {
      background: rgba(255, 226, 191, .72);
      color: #7e5542;
    }

    .road-line {
      position: absolute;
      z-index: 1;
      border-top: 3px dashed rgba(255, 255, 255, .75);
      pointer-events: none;
    }

    .road-line.a {
      width: 48%;
      left: 5%;
      top: 47%;
      transform: rotate(31deg);
    }

    .road-line.b {
      width: 44%;
      right: 1%;
      top: 43%;
      transform: rotate(-33deg);
    }

    .road-line.c {
      width: 35%;
      left: 33%;
      bottom: 16%;
      transform: rotate(-4deg);
    }

    .decor {
      position: absolute;
      z-index: 2;
      display: grid;
      place-items: center;
      width: 27px;
      height: 27px;
      font-size: 1.25rem;
      user-select: none;
      pointer-events: none;
    }

    .decor.d1 {
      left: 7%;
      top: 25%;
    }

    .decor.d2 {
      right: 8%;
      top: 26%;
    }

    .decor.d3 {
      left: 12%;
      bottom: 13%;
    }

    .decor.d4 {
      right: 16%;
      bottom: 14%;
    }

    .decor.d5 {
      left: 48%;
      top: 11%;
    }

    .station,
    .target-house,
    .player {
      position: absolute;
      transform: translate(-50%, -50%);
    }

    .station {
      z-index: 6;
      display: grid;
      place-items: center;
      width: 70px;
      height: 62px;
      border: 3px solid var(--ink);
      border-radius: 15px;
      background: #ffd39e;
      box-shadow: 4px 5px 0 rgba(32, 43, 58, .2);
      text-align: center;
      animation: float 1.7s ease-in-out infinite;
    }

    .station::after {
      content: "AMBIL";
      position: absolute;
      bottom: -21px;
      padding: 2px 6px;
      border: 2px solid var(--ink);
      border-radius: 5px;
      background: var(--paper);
      font-size: .55rem;
      font-weight: 900;
    }

    .station-icon {
      font-size: 1.9rem;
      line-height: 1;
    }

    .station-label {
      font-size: .57rem;
      font-weight: 900;
    }

    .target-house {
      z-index: 5;
      display: grid;
      place-items: center;
      width: 94px;
      min-height: 82px;
      padding: 5px;
      border: 3px solid var(--ink);
      border-radius: 13px;
      background: rgba(255, 255, 255, .94);
      box-shadow: 4px 5px 0 rgba(32, 43, 58, .2);
      text-align: center;
      transition: transform .15s, background .15s, box-shadow .15s;
    }

    .target-house.near {
      transform: translate(-50%, -50%) scale(1.09);
      background: #fff1a6;
      box-shadow: 5px 7px 0 rgba(32, 43, 58, .28);
    }

    .target-house.reached {
      background: #bdebbb;
      border-color: var(--green);
    }

    .house-art {
      font-size: 2.3rem;
      line-height: 1;
    }

    .house-caption {
      font-size: .57rem;
      font-weight: 900;
    }

    .house-number {
      font-size: .9rem;
      font-weight: 900;
    }

    .player {
      z-index: 8;
      display: grid;
      place-items: center;
      width: 56px;
      height: 44px;
      border: 3px solid var(--ink);
      border-radius: 13px 17px 8px 8px;
      background: #ffd05a;
      box-shadow: 0 5px 0 rgba(32, 43, 58, .22);
      font-size: 1.65rem;
      transition: transform .05s linear;
    }

    .player::after {
      content: "";
      position: absolute;
      right: 4px;
      bottom: -9px;
      width: 12px;
      height: 12px;
      border: 2px solid var(--ink);
      border-radius: 50%;
      background: #f8fbff;
      box-shadow: -35px 0 0 -1px #f8fbff, -35px 0 0 1px var(--ink);
    }

    .player.carrying {
      background: #ffb44e;
    }

    .map-message {
      position: absolute;
      z-index: 12;
      left: 50%;
      bottom: 14px;
      width: min(450px, 82%);
      padding: 10px 14px;
      border: 3px solid var(--ink);
      border-radius: 11px;
      background: rgba(255, 255, 255, .94);
      box-shadow: 3px 4px 0 rgba(32, 43, 58, .15);
      font-size: .8rem;
      font-weight: 900;
      text-align: center;
      transform: translateX(-50%);
    }

    .map-message.good {
      background: #dff7d7;
      color: #327149;
    }

    .map-message.warn {
      background: #ffe0d7;
      color: #964449;
    }

    .right-card {
      min-height: 640px;
    }

    .right-body {
      padding: 14px;
    }

    .progress-label {
      display: flex;
      justify-content: space-between;
      margin-bottom: 7px;
      color: var(--muted);
      font-size: .72rem;
      font-weight: 900;
    }

    .progress-track {
      height: 13px;
      margin-bottom: 17px;
      border: 2px solid var(--ink);
      border-radius: 20px;
      background: #eaf0ed;
      overflow: hidden;
    }

    .progress-bar {
      width: 0%;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, #73c9a0, #ffd45e);
      transition: width .3s;
    }

    .mini-rule {
      padding: 11px;
      border: 2px solid var(--ink);
      border-radius: 12px;
      background: var(--yellow);
      text-align: center;
    }

    .mini-rule small {
      display: block;
      margin-bottom: 4px;
      font-size: .65rem;
      font-weight: 900;
      text-transform: uppercase;
    }

    .rule-formula {
      font-size: 1.35rem;
      font-weight: 900;
    }

    .controls-title {
      margin: 20px 0 8px;
      font-size: .75rem;
      font-weight: 900;
      text-transform: uppercase;
    }

    .key-list {
      display: grid;
      gap: 7px;
      color: var(--muted);
      font-size: .75rem;
      font-weight: 800;
    }

    .key-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    kbd {
      display: inline-grid;
      place-items: center;
      min-width: 27px;
      height: 27px;
      padding: 0 6px;
      border: 2px solid var(--ink);
      border-radius: 6px;
      background: var(--paper);
      box-shadow: 0 2px 0 rgba(32, 43, 58, .2);
      color: var(--ink);
      font-size: .75rem;
    }

    .touch-controls {
      display: grid;
      grid-template-columns: repeat(3, 41px);
      grid-template-rows: repeat(2, 39px);
      justify-content: center;
      gap: 5px;
      margin-top: 14px;
    }

    .touch-controls button {
      border: 2px solid var(--ink);
      border-radius: 8px;
      background: #e4f5f5;
      box-shadow: 2px 2px 0 rgba(32, 43, 58, .13);
      font-weight: 900;
      touch-action: none;
    }

    .touch-controls button:nth-child(1) {
      grid-column: 2;
    }

    .touch-controls button:nth-child(2) {
      grid-column: 1;
      grid-row: 2;
    }

    .touch-controls button:nth-child(3) {
      grid-column: 2;
      grid-row: 2;
    }

    .touch-controls button:nth-child(4) {
      grid-column: 3;
      grid-row: 2;
    }

    .bottom-bar {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
    }

    .action {
      padding: 9px 14px;
      border: 3px solid var(--ink);
      border-radius: 10px;
      background: var(--paper);
      box-shadow: 3px 3px 0 rgba(32, 43, 58, .14);
      font-size: .8rem;
      font-weight: 900;
    }

    .action.primary {
      background: var(--sky);
    }

    .action.yellow {
      background: var(--yellow);
    }

    .action:hover {
      transform: translateY(-2px);
    }

    .modal-backdrop {
      position: fixed;
      z-index: 30;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 18px;
      background: rgba(32, 43, 58, .58);
    }

    .modal {
      width: min(500px, 100%);
      padding: 24px;
      border: 3px solid var(--ink);
      border-radius: 20px;
      background: var(--paper);
      box-shadow: 8px 8px 0 rgba(32, 43, 58, .26);
      text-align: center;
    }

    .modal h2 {
      margin-bottom: 6px;
    }

    .modal p {
      color: var(--muted);
      font-size: .88rem;
      line-height: 1.5;
    }

    .answer-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 9px;
      margin: 17px 0 10px;
    }

    .answer {
      padding: 12px;
      border: 3px solid var(--ink);
      border-radius: 11px;
      background: #fff4bd;
      box-shadow: 3px 3px 0 rgba(32, 43, 58, .14);
      font-size: 1.05rem;
      font-weight: 900;
    }

    .answer:hover {
      background: #ffe178;
      transform: translateY(-2px);
    }

    .answer.correct {
      background: #b9e9b4;
      border-color: var(--green);
    }

    .answer.wrong {
      background: #ffc8bf;
      border-color: var(--red);
      animation: shake .35s;
    }

    .modal-note {
      min-height: 25px;
      margin: 0;
      color: var(--muted);
      font-size: .78rem;
      font-weight: 900;
    }

    .hidden {
      display: none !important;
    }

    @keyframes float {
      0%, 100% {
        transform: translate(-50%, -50%) translateY(0);
      }

      50% {
        transform: translate(-50%, -50%) translateY(-7px);
      }
    }

    @keyframes drift {
      from {
        transform: translateX(-4px);
      }

      to {
        transform: translateX(9px);
      }
    }

    @keyframes shake {
      0%, 100% {
        transform: translateX(0);
      }

      25% {
        transform: translateX(-7px);
      }

      75% {
        transform: translateX(7px);
      }
    }

    @media (max-width: 1120px) {
      .game-grid {
        grid-template-columns: 235px minmax(470px, 1fr) 210px;
      }

      .target-house {
        width: 82px;
