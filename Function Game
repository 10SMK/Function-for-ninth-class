        display: none;
      }

      .right-card .touch-controls {
        position: fixed;
        z-index: 25;
        right: 12px;
        bottom: 12px;
        display: grid;
        grid-template-columns: repeat(3, 54px);
        grid-template-rows: repeat(2, 50px);
        gap: 5px;
        padding: 7px;
        border: 3px solid var(--ink);
        border-radius: 16px;
        background: rgba(255, 255, 255, .9);
        box-shadow: 4px 5px 0 rgba(32, 43, 58, .24);
      }

      .right-card .touch-controls button {
        min-width: 50px;
        min-height: 46px;
        border-width: 3px;
        border-radius: 10px;
        background: #d8f2f3;
