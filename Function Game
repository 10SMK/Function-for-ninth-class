<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Courier Quest: Misi Fungsi</title>
  <style>
    :root {
      --ink: #202b3a;
      --muted: #667085;
      --paper: #ffffff;
      --sky: #cceefa;
      --yellow: #ffd766;
      --orange: #f28c52;
      --red: #e76868;
      --green: #4caa78;
      --shadow: 0 6px 0 rgba(32, 43, 58, .16);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      font-family: "Trebuchet MS", "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at 7% 10%, rgba(255, 255, 255, .85) 0 42px, transparent 43px),
        radial-gradient(circle at 93% 17%, rgba(255, 255, 255, .65) 0 52px, transparent 53px),
        linear-gradient(145deg, #bcebf5 0%, #fff2cf 54%, #c7ebcb 100%);
    }

    button {
      font: inherit;
      cursor: pointer;
    }

    .app {
      width: min(1440px, 100%);
      min-height: 100vh;
      margin: auto;
      padding: 14px;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 12px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-mark {
      display: grid;
      place-items: center;
      width: 56px;
      height: 56px;
      border: 3px solid var(--ink);
      border-radius: 16px;
      background: var(--yellow);
      box-shadow: var(--shadow);
      font-size: 29px;
    }

    .eyebrow {
      margin: 0 0 3px;
      color: #805e1e;
      font-size: .7rem;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    h1,
    h2,
    p {
      margin-top: 0;
    }

    h1 {
      margin-bottom: 0;
      font-size: clamp(1.25rem, 2.4vw, 2rem);
      line-height: 1;
    }

    .top-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
    }

    .badge {
      min-height: 41px;
      padding: 9px 13px;
      border: 3px solid var(--ink);
      border-radius: 12px;
      background: var(--paper);
      box-shadow: 3px 3px 0 rgba(32, 43, 58, .14);
      font-size: .84rem;
      font-weight: 900;
    }

    .badge strong {
      color: #9b6512;
    }

    .hearts {
      letter-spacing: 2px;
    }

    .heart-off {
      opacity: .24;
      filter: grayscale(1);
    }

    .game-grid {
      display: grid;
      grid-template-columns: 275px minmax(550px, 1fr) 250px;
      gap: 12px;
      align-items: stretch;
    }

    .card {
      border: 3px solid var(--ink);
      border-radius: 18px;
      background: rgba(255, 255, 255, .95);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .card-heading {
      margin: 0;
      padding: 12px 14px;
      border-bottom: 3px solid var(--ink);
      background: var(--sky);
      font-size: .95rem;
      line-height: 1.1;
    }

    .card-heading small {
      display: block;
      margin-top: 4px;
      color: var(--muted);
      font-size: .7rem;
    }

    .mission-card {
      min-height: 640px;
    }

    .mission-body {
      padding: 14px;
    }

    .mission-intro {
      margin-bottom: 12px;
      padding: 11px;
      border-radius: 12px;
      background: #fff4bf;
      font-size: .83rem;
      font-weight: 800;
      line-height: 1.4;
    }

    .objective {
      padding: 12px;
      border: 2px dashed #c28c22;
      border-radius: 14px;
      background: #fffdf3;
    }

    .objective-label {
      color: var(--muted);
      font-size: .68rem;
      font-weight: 900;
      letter-spacing: .07em;
      text-transform: uppercase;
    }

    .objective-value {
      margin: 5px 0;
      color: #af7113;
      font-size: 2rem;
      font-weight: 900;
    }

    .objective-status {
      min-height: 34px;
      color: var(--muted);
      font-size: .78rem;
      font-weight: 900;
      line-height: 1.35;
    }

    .route-box {
      position: relative;
      margin-top: 14px;
      padding: 14px 10px;
      border-radius: 12px;
      background: #f0f6f2;
    }

