      }

      .mission-card {
        order: 2;
      }

      .right-card {
        order: 3;
      }

      .map {
        height: min(67vh, 570px);
        min-height: 415px;
        border-radius: 10px;
      }

      .map-help {
        display: none;
      }

      .landmark {
        transform: scale(.82);
        transform-origin: center;
      }

      .landmark.school {
        left: 34%;
        top: 26%;
      }

      .landmark.shop {
        right: 3%;
        top: 46%;
      }

      .landmark.park {
        left: 2%;
        bottom: 29%;
      }

      .landmark.cafe {
        right: 31%;
        bottom: 7%;
      }

      .map-sticker {
        left: 10%;
