        padding: 7px;
      }

      .topbar {
        gap: 7px;
        margin-bottom: 8px;
      }

      .brand-mark {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        font-size: 23px;
      }

      .eyebrow {
        font-size: .56rem;
      }

      h1 {
        font-size: 1.12rem;
      }

      .game-grid {
        display: flex;
        flex-direction: column;
      }

      .map-card {
        order: 1;
        min-height: 0;
        padding: 5px;
