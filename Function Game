      }

      .map-message {
        bottom: 9px;
        width: 76%;
        padding: 8px 9px;
        font-size: .7rem;
      }

      .answer {
        min-height: 53px;
        padding: 11px 6px;
        font-size: .95rem;
      }

      .modal {
        padding: 19px 15px;
      }
    }
  </style>
</head>
<body>
  <main class="app">
    <header class="topbar">
      <div class="brand">
        <div class="brand-mark">🚚</div>

        <div>
          <p class="eyebrow">Game Edukasi Matematika</p>
