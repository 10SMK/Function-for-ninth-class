        transform: rotate(-5deg) scale(.9);
      }

      .street-label {
        display: none;
      }

      .target-house {
        width: 72px;
        min-height: 70px;
      }

      .house-art {
        font-size: 1.75rem;
      }

      .house-caption {
        font-size: .48rem;
      }

      .house-number {
        font-size: .75rem;
      }

      .station {
        width: 61px;
        height: 55px;
      }

      .station-icon {
        font-size: 1.5rem;
      }

      .top-stats {
        width: 100%;
      }

      .badge {
        flex: 1;
        min-height: 35px;
        padding: 7px 5px;
        font-size: .7rem;
        text-align: center;
      }

      .bottom-bar {
        gap: 6px;
        margin-top: 8px;
      }

      .action {
