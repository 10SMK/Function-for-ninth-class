      <button class="action primary" id="closeInfoButton">
        Siap Mengantar!
      </button>
    </div>
  </div>

  <script>
    "use strict";

    const levels = [
      {
        formulaText: "f(x) = 3x + 2",
        calculate: (x) => 3 * x + 2,
        missions: [1, 2, 3, 4],
        theme: "level-suburb",
        mapTitle: "KOTA CERIA • ZONA PENGIRIMAN",
        mapHint: "☀️ Siang cerah • gunakan tombol arah",
        sticker: "DELIVERY DAY ✦",
        skyIcon: "☁️",
        landmarks: [
          ["🏫", "SEKOLAH"],
          ["🏪", "MINIMARKET"],
          ["🌳🌳", "TAMAN KOTA"],
          ["☕", "CAFÉ"]
        ]
      },

      {
        formulaText: "f(x) = 2x² + 1",
        calculate: (x) => 2 * x * x + 1,
        missions: [1, 2, 3, 4],
        theme: "level-night",
        mapTitle: "KOTA NEON • RUTE MALAM",
        mapHint: "🌙 Malam neon • cari alamat bercahaya",
        sticker: "NIGHT RUN ✦",
        skyIcon: "✦",
        landmarks: [
          ["🌃", "MENARA"],
          ["🌙", "NIGHT SHOP"],
          ["🌌", "OBSERVATORIUM"],
          ["🎵", "CLUB"]
        ]
      },

      {
        formulaText: "f(x) = x² + 3x + 2",
        calculate: (x) => x * x + 3 * x + 2,
        missions: [1, 2, 3, 4, 5],
        theme: "level-coast",
        mapTitle: "PANTAI CERIA • RUTE PESISIR",
        mapHint: "🌊 Angin laut • kirim paket ke pesisir",
        sticker: "COASTAL ROUTE ✦",
        skyIcon: "☀️",
        landmarks: [
          ["⛱️", "PANTAI"],
          ["🛟", "PELABUHAN"],
          ["🐚", "TAMAN LAUT"],
          ["🍹", "KAFE PANTAI"]
        ]
      },

      {
        formulaText: "f(x) = 2(x + 1)² − 3",
        calculate: (x) => 2 * (x + 1) * (x + 1) - 3,
        missions: [1, 2, 3, 4, 5],
        theme: "level-industrial",
        mapTitle: "KAWASAN INDUSTRI • SHIFT SORE",
        mapHint: "🏭 Kawasan padat • baca fungsi dengan teliti",
        sticker: "FACTORY SHIFT ✦",
        skyIcon: "⚡",
        landmarks: [
          ["🏭", "PABRIK"],
          ["🚉", "STASIUN"],
          ["🛠️", "BENGKEL"],
          ["⚙️", "GUDANG"]
        ]
      },

      {
        formulaText: "f(x) = 3x² − 2x + 4",
        calculate: (x) => 3 * x * x - 2 * x + 4,
        missions: [1, 2, 3, 4, 5, 6],
        theme: "level-festival",
        mapTitle: "KOTA FESTIVAL • FINAL DELIVERY",
        mapHint: "🎪 Festival malam • tantangan terakhir",
        sticker: "FINAL DELIVERY ✦",
        skyIcon: "✦",
        landmarks: [
          ["🎪", "FESTIVAL"],
          ["🎡", "PASAR MALAM"],
          ["🌲", "HUTAN"],
          ["🔥", "CAMP"]
        ]
      }
    ];

    const housePositions = [
      { left: 78, top: 22 },
      { left: 82, top: 70 },
      { left: 21, top: 78 },
      { left: 54, top: 17 }
    ];

    const state = {
      level: 0,
      missionIndex: 0,
      score: 0,
      lives: 3,
      hasPackage: false,
      moving: {},
      player: {
        x: 49,
        y: 52
      },
      puzzleOpen: false,
      gameFinished: false,
      lastTime: 0
    };

    const el = {
      map: document.getElementById("map"),
      mapHelp: document.getElementById("mapHelp"),
      mapSticker: document.getElementById("mapSticker"),
      clouds: [...document.querySelectorAll(".cloud")],
      landmarks: [...document.querySelectorAll(".landmark")],
      player: document.getElementById("player"),
      station: document.getElementById("station"),
      houses: [...document.querySelectorAll(".target-house")],
      levelText: document.getElementById("levelText"),
      scoreText: document.getElementById("scoreText"),
      livesText: document.getElementById("livesText"),
      packageValue: document.getElementById("packageValue"),
      objectiveStatus: document.getElementById("objectiveStatus"),
      formulaText: document.getElementById("formulaText"),
      progressText: document.getElementById("progressText"),
      progressBar: document.getElementById("progressBar"),
      mapMessage: document.getElementById("mapMessage"),
      routePickup: document.getElementById("routePickup"),
      routeDeliver: document.getElementById("routeDeliver"),
      routeSolve: document.getElementById("routeSolve"),
      hintButton: document.getElementById("hintButton"),
      resetButton: document.getElementById("resetButton"),
      nextButton: document.getElementById("nextButton"),
      howButton: document.getElementById("howButton"),
      puzzleModal: document.getElementById("puzzleModal"),
      puzzleTitle: document.getElementById("puzzleTitle"),
      puzzleQuestion: document.getElementById("puzzleQuestion"),
      answerGrid: document.getElementById("answerGrid"),
      modalNote: document.getElementById("modalNote"),
      closePuzzleButton: document.getElementById("closePuzzleButton"),
      infoModal: document.getElementById("infoModal"),
      closeInfoButton: document.getElementById("closeInfoButton")
    };

    function currentLevel() {
      return levels[state.level];
    }

    function currentValue() {
      return currentLevel().missions[state.missionIndex];
    }

    function currentAnswer() {
      return currentLevel().calculate(currentValue());
    }

    function setMessage(text, type = "") {
      el.mapMessage.textContent = text;
      el.mapMessage.className = `map-message ${type}`;
    }

    function renderMapTheme(level) {
      el.map.className = `map ${level.theme}`;
      el.map.dataset.title = level.mapTitle;
      el.mapHelp.textContent = level.mapHint;
      el.mapSticker.textContent = level.sticker;

      el.clouds.forEach((cloud) => {
        cloud.textContent = level.skyIcon;
      });

      el.landmarks.forEach((landmark, index) => {
        const [icon, label] = level.landmarks[index];

        landmark.querySelector(".landmark-icon").textContent = icon;
        landmark.querySelector("span").textContent = label;
      });
    }

    function render() {
      const level = currentLevel();

      renderMapTheme(level);

      el.levelText.textContent = state.level + 1;
      el.scoreText.textContent = state.score;

      el.livesText.innerHTML = [0, 1, 2]
        .map((index) => {
          const off = index >= state.lives ? "heart-off" : "";
          return `<span class="${off}">❤️</span>`;
        })
        .join("");

      el.packageValue.textContent = `x = ${currentValue()}`;
      el.formulaText.textContent = level.formulaText;
      el.progressText.textContent = `${state.missionIndex} / ${level.missions.length}`;
      el.progressBar.style.width =
        `${(state.missionIndex / level.missions.length) * 100}%`;

      el.player.style.left = `${state.player.x}%`;
      el.player.style.top = `${state.player.y}%`;
      el.player.classList.toggle("carrying", state.hasPackage);
      el.station.classList.toggle("hidden", state.hasPackage);

      el.houses.forEach((house) => {
        house.classList.remove("near", "reached");
      });

      updateRoute();
    }

    function updateRoute() {
      el.routePickup.classList.toggle("active", !state.hasPackage);
      el.routePickup.classList.toggle("done", state.hasPackage);
      el.routeDeliver.classList.toggle("active", state.hasPackage);
      el.routeDeliver.classList.toggle("done", false);
      el.routeSolve.classList.toggle("active", false);

      if (state.hasPackage) {
        el.objectiveStatus.textContent =
          `Antarkan paket x = ${currentValue()} ke rumah bernomor ${currentAnswer()}.`;
      } else {
        el.objectiveStatus.textContent =
          "Pergi ke stasiun paket untuk mengambil paket.";
      }
    }

    function resetLevel() {
      state.missionIndex = 0;
      state.lives = 3;
      state.hasPackage = false;
      state.puzzleOpen = false;
      state.gameFinished = false;
      state.player = {
        x: 49,
        y: 52
      };

      closePuzzle();
      setHouseNumbers();
      setMessage("Cari stasiun oranye untuk mengambil paket.");
      render();
    }

    function setHouseNumbers() {
      const level = currentLevel();
      const correctAnswer = level.calculate(level.missions[state.missionIndex]);

      const answers = level.missions
        .map(level.calculate)
        .filter((answer) => answer !== correctAnswer);

      let distractor =
        correctAnswer + (state.missionIndex % 2 === 0 ? 3 : -3);

      while (answers.includes(distractor) || distractor === correctAnswer) {
        distractor += 2;
      }

      const houseValues = [
        correctAnswer,
        ...answers.slice(0, 2),
        distractor
      ].filter((value, index, array) => {
        return array.indexOf(value) === index;
      });

      el.houses.forEach((house, index) => {
        const value = houseValues[index];

        house.querySelector(".house-number").textContent = value;
        house.dataset.value = value;
        house.dataset.correct = String(value === correctAnswer);
        house.style.left = `${housePositions[index].left}%`;
        house.style.top = `${housePositions[index].top}%`;
      });
    }

    function startNextMission() {
      if (state.missionIndex >= currentLevel().missions.length) {
        return;
      }

      state.hasPackage = false;
      state.puzzleOpen = false;

      setHouseNumbers();
      setMessage("Paket baru tersedia. Datangi stasiun oranye.");
      render();
    }

    function takePackage() {
      if (state.hasPackage || state.gameFinished) {
        return;
      }

      state.hasPackage = true;

      el.routeDeliver.classList.add("active");

      setMessage(
        `Paket x = ${currentValue()} diambil! Cari Rumah ${currentAnswer()}.`,
        "good"
      );

      render();
    }

    function tryReachHouse(house) {
      if (!state.hasPackage || state.puzzleOpen || state.gameFinished) {
        return;
      }

      if (house.dataset.correct !== "true") {
        setMessage(
          `Rumah ${house.dataset.value} bukan tujuan yang tepat. Hitung lagi f(x).`,
          "warn"
        );
        return;
      }

      openPuzzle(house);
    }

    function openPuzzle(house) {
      state.puzzleOpen = true;

      const value = currentValue();
      const answer = currentAnswer();
      const level = currentLevel();
      const choices = createChoices(answer);

      el.puzzleTitle.textContent = `🏠 Rumah ${house.dataset.value}`;

      el.puzzleQuestion.textContent =
        `Paket bernilai x = ${value}. Berapakah hasil ${level.formulaText}?`;

      el.answerGrid.innerHTML = "";
      el.modalNote.textContent =
        "Pilih jawaban yang benar untuk menyelesaikan pengiriman.";

      choices.forEach((choice) => {
        const button = document.createElement("button");

        button.className = "answer";
        button.textContent = choice;

        button.addEventListener("click", () => {
          answerPuzzle(
            button,
            Number(choice),
            answer,
            house
          );
        });

        el.answerGrid.appendChild(button);
      });

      el.puzzleModal.classList.remove("hidden");
    }

    function createChoices(answer) {
      const choices = new Set([answer]);

      [
        answer - 3,
        answer + 3,
        answer + 5,
        Math.max(1, answer - 5)
      ].forEach((value) => {
        choices.add(value);
      });

      return [...choices]
        .sort(() => Math.random() - .5)
        .slice(0, 4);
    }

    function answerPuzzle(button, selected, answer, house) {
      const buttons = [
        ...el.answerGrid.querySelectorAll(".answer")
      ];

      buttons.forEach((item) => {
        item.disabled = true;
      });

      const deliveredValue = currentValue();

      if (selected === answer) {
        button.classList.add("correct");

        state.score += 50;
        state.hasPackage = false;
        state.missionIndex += 1;

        house.classList.add("reached");
        el.routeSolve.classList.add("done");

        el.modalNote.textContent =
          `Benar! f(${deliveredValue}) = ${answer}. +50 poin`;

        el.progressBar.style.width =
          `${(state.missionIndex / currentLevel().missions.length) * 100}%`;

        setMessage(
          `Pengiriman berhasil! Rumah ${answer} menerima paket.`,
          "good"
        );

        setTimeout(() => {
          closePuzzle();

          if (state.missionIndex >= currentLevel().missions.length) {
            finishLevel();
          } else {
            startNextMission();
          }
        }, 850);
      } else {
        button.classList.add("wrong");
        state.lives -= 1;

        el.modalNote.textContent =
          `Belum tepat. Coba hitung kembali substitusi x = ${currentValue()}.`;

        buttons.forEach((item) => {
          if (Number(item.textContent) === answer) {
            item.disabled = false;
          }
        });

        updateLives();

        if (state.lives <= 0) {
          setTimeout(() => {
            closePuzzle();

            showInfo(
              "Nyawa Habis 💔",
              "Kurir belum berhasil menyelesaikan misi. Ulangi level ini dan hitung fungsi dengan lebih teliti.",
              "Coba Lagi",
              resetLevel
            );
          }, 600);
        }
      }
    }

    function closePuzzle() {
      state.puzzleOpen = false;
      el.puzzleModal.classList.add("hidden");
    }

    function finishLevel() {
      state.gameFinished = true;

      setTimeout(() => {
        const last = state.level === levels.length - 1;

        showInfo(
          last
            ? "Kota Berhasil Dilayani! 🎉"
            : "Level Berhasil! 🎉",

          last
            ? `Semua paket sudah terkirim. Skor akhir kamu ${state.score}.`
            : `Semua misi di Level ${state.level + 1} selesai. Siap menghadapi fungsi berikutnya?`,

          last ? "Main dari Awal" : "Lanjut Level",

          () => {
            if (last) {
              state.level = 0;
              state.score = 0;
            } else {
              state.level += 1;
            }

            resetLevel();
          }
        );
      }, 300);
    }

    function updateLives() {
      el.livesText.innerHTML = [0, 1, 2]
        .map((index) => {
          const off = index >= state.lives ? "heart-off" : "";
          return `<span class="${off}">❤️</span>`;
        })
        .join("");

      el.scoreText.textContent = state.score;
    }

    function showHint() {
      const value = currentValue();
      const answer = currentAnswer();

      if (!state.hasPackage) {
        setMessage(
          `Petunjuk: ambil paket bernilai x = ${value} di stasiun oranye.`,
          "warn"
        );
        return;
      }

      setMessage(
        `Petunjuk: substitusikan x = ${value} ke fungsi. Hasilnya adalah ${answer}.`,
        "warn"
      );
    }

    function showInfo(title, text, buttonText, callback) {
      document.getElementById("infoTitle").textContent = title;
      document.getElementById("infoText").textContent = text;
      el.closeInfoButton.textContent = buttonText;
      el.infoModal.classList.remove("hidden");

      el.closeInfoButton.onclick = () => {
        el.infoModal.classList.add("hidden");

        if (callback) {
          callback();
        }
      };
    }

    function updateMovement(delta) {
      if (state.puzzleOpen || state.gameFinished) {
        return;
      }

      const speed = 0.055 * delta;

      let dx = 0;
      let dy = 0;

      if (state.moving.up) {
        dy -= speed;
      }

      if (state.moving.down) {
        dy += speed;
      }

      if (state.moving.left) {
        dx -= speed;
      }

      if (state.moving.right) {
        dx += speed;
      }

      if (!dx && !dy) {
        return;
      }

      state.player.x = Math.max(
        5,
        Math.min(95, state.player.x + dx)
      );

      state.player.y = Math.max(
        9,
        Math.min(92, state.player.y + dy)
      );

      renderPlayerOnly();
      checkCollisions();
    }

    function renderPlayerOnly() {
      el.player.style.left = `${state.player.x}%`;
      el.player.style.top = `${state.player.y}%`;
    }

    function distanceTo(element) {
      const rect = el.map.getBoundingClientRect();
      const targetRect = element.getBoundingClientRect();

      const tx =
        ((targetRect.left + targetRect.width / 2 - rect.left) /
          rect.width) *
        100;

      const ty =
        ((targetRect.top + targetRect.height / 2 - rect.top) /
          rect.height) *
        100;

      return Math.hypot(
        state.player.x - tx,
        state.player.y - ty
      );
    }

    function checkCollisions() {
      const stationDistance = distanceTo(el.station);

      if (!state.hasPackage && stationDistance < 7) {
        el.station.classList.add("near");
        takePackage();
      } else {
        el.station.classList.remove("near");
      }

      el.houses.forEach((house) => {
        const near = distanceTo(house) < 8;

        house.classList.toggle(
          "near",
          near && state.hasPackage
        );

        if (near && state.hasPackage) {
          tryReachHouse(house);
        }
      });
    }

    function gameLoop(timestamp) {
      if (!state.lastTime) {
        state.lastTime = timestamp;
      }

      const delta = Math.min(
        timestamp - state.lastTime,
        35
      );

      state.lastTime = timestamp;

      updateMovement(delta);
      requestAnimationFrame(gameLoop);
    }

    function setMovement(direction, active) {
      state.moving[direction] = active;
    }

    document.addEventListener("keydown", (event) => {
      const key = event.key.toLowerCase();

      const keys = {
        arrowup: "up",
        w: "up",
        arrowdown: "down",
        s: "down",
        arrowleft: "left",
        a: "left",
        arrowright: "right",
        d: "right"
      };

      const direction = keys[key];

      if (direction) {
        event.preventDefault();
        setMovement(direction, true);
      }
    });

    document.addEventListener("keyup", (event) => {
      const key = event.key.toLowerCase();

      const keys = {
        arrowup: "up",
        w: "up",
        arrowdown: "down",
        s: "down",
        arrowleft: "left",
        a: "left",
        arrowright: "right",
        d: "right"
      };

      const direction = keys[key];

      if (direction) {
        setMovement(direction, false);
      }
    });

    document.querySelectorAll("[data-direction]").forEach((button) => {
      const direction = button.dataset.direction;

      const start = (event) => {
        event.preventDefault();
        setMovement(direction, true);
      };

      const stop = (event) => {
        event.preventDefault();
        setMovement(direction, false);
      };

      button.addEventListener("pointerdown", start);
      button.addEventListener("pointerup", stop);
      button.addEventListener("pointerleave", stop);
      button.addEventListener("pointercancel", stop);
    });

    el.hintButton.addEventListener("click", showHint);
    el.resetButton.addEventListener("click", resetLevel);

    el.nextButton.addEventListener("click", () => {
      if (state.level < levels.length - 1) {
        state.level += 1;
        resetLevel();
      } else {
        showInfo(
          "Level Terakhir",
          "Selesaikan semua misi di level ini untuk menamatkan permainan.",
          "Mengerti"
        );
      }
    });

    el.howButton.addEventListener("click", () => {
      showInfo(
        "Cara Bermain 🚚",
        "Gunakan WASD atau tombol panah untuk menggerakkan kurir. Datangi stasiun oranye, ambil paket, lalu cari rumah dengan nomor hasil fungsi. Setelah tiba, jawab teka-tekinya.",
        "Siap Mengantar!"
      );
    });

    el.closePuzzleButton.addEventListener("click", closePuzzle);

    setHouseNumbers();
    render();
    requestAnimationFrame(gameLoop);
  </script>
</body>
</html>
